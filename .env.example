# Valfria mät-ID:n. Lämna tomt för att inte ladda respektive Google-tjänst.
VITE_GA_MEASUREMENT_ID=
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_LEAD_LABEL=

# Publik URL till den serverless-proxy som tar emot offertförfrågningar.
# På en Netlify-hostad frontend kan samma-origin-värdet /api/quote-request användas.
VITE_QUOTE_REQUEST_ENDPOINT=

# Servervariabler för proxyfunktionen (ska aldrig börja med VITE_ eller byggas in i klienten):
# N8N_QUOTE_WEBHOOK_URL=
# N8N_QUOTE_WEBHOOK_SECRET=
# QUOTE_RATE_LIMIT_SALT=
# QUOTE_ALLOWED_ORIGINS=https://ytterman.com
